# Cloudflare Pages cache-control. Hashotie aktīvi (JS/CSS) tiek kešoti ilgi (saturs-hash),
# bet HTML un versijas marķieris vienmēr jārevalidē, lai lietotāji (t.sk. mobilie) saņem jaunāko.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/data/version.json
  Cache-Control: no-cache, must-revalidate
# Datu JSON: vienmēr revalidē (nosacījuma pieprasījums → 304, ja nemainīts = bez atkārtotas
# lejupielādes; svaigi dati uzreiz pēc deploy). Iepriekš SWR max-age radīja līdz 5 min aizkavi.
/data/*
  Cache-Control: no-cache, must-revalidate
